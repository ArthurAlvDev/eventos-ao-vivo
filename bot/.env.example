# Token do Bot do Telegram gerado via @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Seu ID numérico do Telegram (descubra enviando mensagem para @userinfobot no Telegram)
# Importante para impedir que terceiros usem seu bot!
ALLOWED_TELEGRAM_USER_ID=123456789

# Dados do Repositório GitHub
GITHUB_OWNER=seu-usuario-ou-org
GITHUB_REPO=Eventos-Ao-Vivo
GITHUB_BRANCH=main

# Personal Access Token (PAT) do GitHub com permissões de 'repo' ou 'workflow' / 'contents'
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nome do arquivo de workflow no GitHub Actions
GITHUB_WORKFLOW_FILE=buscador.yml
